# =============================================================================
# TAI Tutor AI Backend - Environment Configuration
# =============================================================================
# This file contains all environment variables for the backend server.
# =============================================================================

# =============================================================================
# Server Configuration
# =============================================================================
REACT_APP_BACKEND_URL=http://localhost:5000
BACKEND_PORT=5000
MAIN_PROJECT_DIR=/home/h703255227/Documents/00Capstone/TAI-tutor-ai

# =============================================================================
# Authentication
# =============================================================================
# Set to "true", "1", "yes", or "on" to disable authentication (dev/testing only)
DISABLE_AUTH=false

# Default development user (used when auth is disabled)
DEFAULT_DEV_USER=dev

# JWT Configuration
JWT_SECRET_KEY=tai-tutor-secret-key
JWT_ALGORITHM=HS256
JWT_EXP_SECONDS=3600

# =============================================================================
# Ollama LLM Configuration
# =============================================================================
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM=llama3:8b
OLLAMA_EMBED=bge-m3:latest

# Default generation parameters
DEFAULT_TEMPERATURE=0.5
DEFAULT_MAX_TOKENS=1024
DEFAULT_TIMEOUT=600

# Default prompt mode: 'hint' or 'direct'
DEFAULT_PROMPT_MODE=direct

# =============================================================================
# Planner Configuration
# =============================================================================
PLAN_MODEL=llama3:8b
PLAN_TEMPERATURE=0.15
PLAN_MAX_TOKENS=1024

# =============================================================================
# Quiz Configuration
# =============================================================================
QUIZ_MODEL=llama3:8b
QUIZ_TEMPERATURE=0.3
QUIZ_MAX_TOKENS=2048

# =============================================================================
# CodeQuest Configuration
# =============================================================================
# General model for CodeQuest (if set, used as fallback for specific models)
CODEQUEST_GENERAL_MODEL=gpt-oss:20b

# Specific models for different CodeQuest operations
CODEQUEST_GENERATOR_MODEL=gpt-oss:20b
CODEQUEST_SUBMIT_MODEL=codellama:34b-instruct
CODEQUEST_RUN_MODEL=codellama:34b-instruct

# Set to "true" to enable LLM-based challenge generation and evaluation
CODEQUEST_LLM_ENABLED=true

# =============================================================================
# Cache Configuration
# =============================================================================
CACHE_ENABLED=true
CACHE_MAX_SIZE=100
CACHE_TTL_SECONDS=3600

# =============================================================================
# Index/RAG Configuration
# =============================================================================
INDEX_DIR=./vector_index_store
DATA_DIR=./course-data
EMBEDDINGS_DIR=./embeddings

# Rebuild cooldown in seconds (prevents frequent rebuilds)
REBUILD_COOLDOWN_SECONDS=60

# =============================================================================
# Storage Directories
# =============================================================================
CHAT_STORE_DIR=../user_data/chats
CODEQUEST_STORE_DIR=../user_data/codequest

# =============================================================================
# Debug Configuration
# =============================================================================
# Set to "1" to enable debug endpoint (_debug/env)
BACKEND_DEBUG=0

# Set to any value to enable mock LLM responses (for testing)
# MOCK_LLM_ECHO=1