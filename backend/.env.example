# =============================================================================
# TAI Tutor AI Backend - Environment Configuration Example
# =============================================================================
# Copy this file to .env and fill in appropriate values.
# =============================================================================

# =============================================================================
# Server Configuration
# =============================================================================
BACKEND_PORT=5000
MAIN_PROJECT_DIR=/path/to/TAI-tutor-ai

# =============================================================================
# Authentication
# =============================================================================
# Set to "true", "1", "yes", or "on" to disable authentication (dev/testing only)
DISABLE_AUTH=false

# Default development user (used when auth is disabled)
DEFAULT_DEV_USER=dev@dev.com

# JWT secret key (should be a long random string in production)
JWT_SECRET_KEY=your-secret-key-here

# =============================================================================
# Admin Configuration
# =============================================================================
# Admin username (default: "admin")
ADMIN_USERNAME=admin

# Admin password (default: "admin" - CHANGE IN PRODUCTION!)
ADMIN_PASSWORD=admin

# =============================================================================
# Ollama LLM Configuration
# =============================================================================
OLLAMA_LLM=llama3:8b
OLLAMA_EMBED=bge-m3:latest

# Default generation parameters
DEFAULT_TEMPERATURE=0.5
DEFAULT_MAX_TOKENS=1024
DEFAULT_TIMEOUT=600

# Default prompt mode: 'hint' or 'direct'
DEFAULT_PROMPT_MODE=direct

# =============================================================================
# Planner Configuration
# =============================================================================
PLAN_MODEL=gpt-oss:latest
PLAN_TEMPERATURE=0.15
PLAN_MAX_TOKENS=1024

# =============================================================================
# CodeQuest Configuration
# =============================================================================
CODEQUEST_GENERATOR_MODEL=codellama:34b
CODEQUEST_SUBMIT_MODEL=gpt-oss:20b

# Set to "true" to enable LLM-based challenge generation and evaluation
CODEQUEST_LLM_ENABLED=true

# =============================================================================
# Cache Configuration
# =============================================================================
CACHE_ENABLED=true
CACHE_MAX_SIZE=100
CACHE_TTL_SECONDS=3600

# =============================================================================
# Index/RAG Configuration
# =============================================================================
INDEX_DIR=./vector_index_store
DATA_DIR=./course-data
EMBEDDINGS_DIR=./embeddings

# Rebuild cooldown in seconds (prevents frequent rebuilds)
REBUILD_COOLDOWN_SECONDS=60

# =============================================================================
# Storage Directories
# =============================================================================
CHAT_STORE_DIR=../user_data/chats
CODEQUEST_STORE_DIR=../user_data/codequest

# =============================================================================
# Debug Configuration
# =============================================================================
# Set to "1" to enable debug endpoint (_debug/env)
BACKEND_DEBUG=0

# Set to any value to enable mock LLM responses (for testing)
# MOCK_LLM_ECHO=1
