# Auto-generated .env for this workspace (safe defaults)
# Edit values as needed. This file was created automatically to speed local development.

# Backend server
REACT_APP_BACKEND_URL=http://localhost:5000
BACKEND_PORT=5000

# Authentication
# Set to 'true' to disable auth checks for local development (dev-only).
DISABLE_AUTH=false
# When DISABLE_AUTH=true, frontend will auto-fill this as the dev user id if present.
DEFAULT_DEV_USER=dev

# Project root used for saving/listing plans. Set to this workspace root by default.
MAIN_PROJECT_DIR=/home/h703255227/Documents/00Capstone/TAI-tutor-ai

# Planner / LLM settings
PLAN_MODEL=llama3:8b
PLAN_TEMPERATURE=0.15
PLAN_MAX_TOKENS=1024

# Ollama / Embedding defaults (change to match your local Ollama models)
OLLAMA_LLM=llama3:8b
OLLAMA_EMBED=bge-m3:latest

# Global defaults for model calls
DEFAULT_TEMPERATURE=0.5
DEFAULT_MAX_TOKENS=1024
DEFAULT_TIMEOUT=600

# Data and index directories (relative to MAIN_PROJECT_DIR if set)
EMBEDDINGS_DIR=./embeddings
INDEX_DIR=./vector_index_store
DATA_DIR=./course-data

# General model for CodeQuest. If non-empty, the other CODEQUEST_* vars will use this.
CODEQUEST_GENERAL_MODEL=gpt-oss:20b

# If CODEQUEST_GENERAL_MODEL is non-empty, these will resolve to it; otherwise they fall back to the default.
CODEQUEST_GENERATOR_MODEL=gpt-oss:20b
CODEQUEST_SUBMIT_MODEL=codellama:34b-instruct
CODEQUEST_RUN_MODEL=codellama:34b-instruct